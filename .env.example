# Copy to .env. Fill the installation settings below; keep the completed file private.
# Use with Onify's keyfile.json for either Kubernetes or local Docker testing.
# Examples show the format only; use approved versions and your own credentials.
# Approved image version tags (repositories are already set in compose.yaml).
API_TAG="" # API and background worker image version; e.g. 1.2.3 (confirm with Onify).
APP_TAG="" # Citizen web app (app-root) image version; e.g. 4.5.6 (confirm with Onify).
GATEWAY_TAG="" # Gateway integration service image version; e.g. 7.8.9 (confirm with Onify).

# Match the license; together these identify this installation and its data.
ONIFY_client_code="" # Customer code from the license; e.g. acme.
ONIFY_client_instance="" # Environment code from the license; e.g. test or prod.
ONIFY_adminUser_username=admin # Username for the initial administrator login; e.g. admin.

# Local testing only: public APP/API/login port. Not used by Kubernetes.
APP_PORT=80 # Local browser port; e.g. 8080 opens the app at http://localhost:8080.

# Keep single quotes around values so $, # and spaces stay literal.
# Generate the password and each secret separately with: openssl rand -hex 32.
# Secret examples below are abbreviated; use the full generated value.
ONIFY_initialLicense="" # License supplied by Onify; e.g. 'REPLACE_WITH_CLIENT_LICENSE' (paste the full license).
ONIFY_adminUser_password="" # Password for the initial administrator login; e.g. 'a4b1...9f20' (64 hex characters).
ONIFY_apiTokens_app_secret="" # Secret for the API's APP token; e.g. 'b5c2...0a31' (64 hex characters).
ONIFY_client_secret="" # Client secret shared by API and Gateway for user token authentication; e.g. 'c6d3...1b42' (64 hex characters).

# Kubernetes only: all settings have defaults, including when omitted or empty.
# Replace example.com hosts with real DNS names before a live deployment.
K8S_NAMESPACE=${ONIFY_client_code}-${ONIFY_client_instance} # Kubernetes namespace grouping this installation's resources; e.g. acme-test.
K8S_APP_HOST=${ONIFY_client_code}-${ONIFY_client_instance}.example.com # Web app DNS name, without https://; e.g. citizen.example.com.
K8S_API_HOST=api-${ONIFY_client_code}-${ONIFY_client_instance}.example.com # API DNS name, distinct from the app host; e.g. api.example.com.
K8S_INGRESS_CLASS=nginx # Existing Ingress class handling incoming web traffic; e.g. nginx.
K8S_CLUSTER_ISSUER=letsencrypt-prod # Existing cert-manager ClusterIssuer issuing HTTPS certificates; e.g. letsencrypt-prod.
K8S_INGRESS_CONTROLLER_NAMESPACE=ingress-nginx # Namespace of the Ingress controller allowed through the network policy; e.g. ingress-nginx.
K8S_INGRESS_CONTROLLER_NAME=ingress-nginx # Controller pod's app.kubernetes.io/name label for the network policy; e.g. ingress-nginx.
K8S_STORAGE_SIZE=10Gi # Persistent Elasticsearch disk size; e.g. 20Gi for 20 gibibytes.
K8S_STORAGE_CLASS="" # Existing StorageClass for the disk; e.g. standard. Empty uses the cluster default.
