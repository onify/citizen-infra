# Copy to .env. Fill the installation settings below; keep the completed file private.
# Use with Onify's keyfile.json for either Kubernetes or local Docker testing.
# Approved image version tags (repositories are already set in compose.yaml).
API_TAG=
APP_TAG=
GATEWAY_TAG=

# Match the license; together these identify this installation and its data.
ONIFY_client_code=
ONIFY_client_instance=
ONIFY_adminUser_username=admin

# Local testing only: public APP/API/login port. Not used by Kubernetes.
APP_PORT=80

# Keep single quotes around values so $, # and spaces stay literal.
ONIFY_initialLicense=''
ONIFY_adminUser_password=''
ONIFY_apiTokens_app_secret=''
ONIFY_client_secret=''

# Kubernetes only: all settings have defaults, including when omitted or empty.
# Replace example.com hosts with real DNS names before a live deployment.
K8S_NAMESPACE=${ONIFY_client_code}-${ONIFY_client_instance}
K8S_APP_HOST=${ONIFY_client_code}-${ONIFY_client_instance}.example.com
K8S_API_HOST=api-${ONIFY_client_code}-${ONIFY_client_instance}.example.com
K8S_INGRESS_CLASS=nginx
K8S_CLUSTER_ISSUER=letsencrypt-prod
K8S_INGRESS_CONTROLLER_NAMESPACE=ingress-nginx
K8S_INGRESS_CONTROLLER_NAME=ingress-nginx
K8S_STORAGE_SIZE=10Gi
# Empty selects the cluster's default StorageClass.
K8S_STORAGE_CLASS=
