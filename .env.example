# Copy to .env. Fill every blank; keep the completed file private.
# Approved image version tags (repositories are already set in compose.yaml).
API_TAG=
APP_TAG=
GATEWAY_TAG=

# Match the development license; together these identify this installation and its data.
ONIFY_client_code=
ONIFY_client_instance=
ONIFY_adminUser_username=admin

# One public port for APP, /api/v2 and login. Change it for another installation.
APP_PORT=80

# Keep single quotes around values so $, # and spaces stay literal.
ONIFY_initialLicense=''
ONIFY_adminUser_password=''
ONIFY_apiTokens_app_secret=''
ONIFY_client_secret=''
