NODE_ENV=production
GATEWAY_HOST=0.0.0.0
GATEWAY_TENANCY=single
GATEWAY_FAKE_MODE=false
GATEWAY_AUTH=onify-halo-api
# Gateway enables these standard connections unless explicitly disabled.
GATEWAY_INTEGRATION_ACTORSMARTBOOK_ASSOCIATIONS_ENABLED=false
GATEWAY_INTEGRATION_BYGGR_CASES_ENABLED=false
GATEWAY_INTEGRATION_SSBTGO_ORGANIZATIONS_ENABLED=false
# Enable only the integrations approved for this installation. See docs/configuration.md.
# Put provider URLs and non-secret settings here; credentials go in gateway-secrets.env.
